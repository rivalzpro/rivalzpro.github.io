            VALUE "CompanyName",      "RANGE Precision Esports\0"
            VALUE "FileDescription",  "Roblox Rivals - RANGE Precision Aim Trainer Desktop App\0"
            VALUE "FileVersion",      "3.3.0.0\0"
            VALUE "InternalName",     "RangeAimTrainer\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RANGE Esports\0"
            VALUE "OriginalFilename", "Roblox_Rivals_RANGE_Aim_Trainer.exe\0"
            VALUE "ProductName",      "Roblox Rivals RANGE Precision Aim Trainer\0"
            VALUE "ProductVersion",   "3.3.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
