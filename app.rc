#include <windows.h>

#define IDI_APPICON 101
#define IDR_HTML_APP 201

IDI_APPICON ICON "app.ico"
IDR_HTML_APP RCDATA "public/range_standalone.html"

// Embedded Application Manifest
1 24 "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,3,0,0
PRODUCTVERSION  3,3,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
